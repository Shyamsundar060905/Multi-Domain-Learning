{
  "domains": ["LEVIR", "WHU", "SYSU"],
  "epochs": 150,
  "lr": 0.0002,
  "weight_decay": 0.0001,
  "batch_size": 4,
  "image_size": 512,
  "num_workers": 4,
  "seed": 42,
  "positive_only": true,
  "balance_domain_samples": false,
  "max_train_samples_per_domain": 1525,
  "schedule": "round_robin",
  "domain_order": ["LEVIR", "WHU", "SYSU"],
  "scheduler_step_size": 50,
  "scheduler_gamma": 0.1,
  "deep_supervision_weight": 0.4,
  "dice_weight": 0.7,
  "bce_weight": 0.3,
  "focal_gamma": 2.0,
  "pos_weight_per_domain": ["LEVIR=10.0", "WHU=3.0", "SYSU=2.0"],
  "backbone": "unet",
  "unet_adapter_stages": ["l1", "l2", "l3", "l4"],
  "unfreeze_backbone": true,
  "use_recon": true,
  "recon_weight": 0.1,
  "recon_change": true,
  "recon_change_weight": 1.0,
  "recon_change_stages": [3],
  "select_metric": "f1",
  "ckpt_dir": "checkpoints/rchg_s3_levir_whu_sysu",
  "whu_dir": "./Data/WHU",
  "levir_dir": "./Data/LEVIR CD",
  "sysu_dir": "./Data/SYSU-CD"
}
